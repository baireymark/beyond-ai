# Copy to .env.local for local development, and add the same variables in Vercel → Project → Settings →
# Environment Variables (Production, Preview and any staging environment).

# ── Contact form → BeyondAi Admin enquiry API ────────────────────────────────────────────────────────────────
# The browser posts each enquiry straight to {NEXT_PUBLIC_ENQUIRY_API_URL}/api/leads, where it is saved as a lead.
# These are public (NEXT_PUBLIC_): Next.js inlines them into the browser bundle at build time, so redeploy after
# changing them. None of them is a secret.

# Base URL of the admin app, without /api/leads (a trailing slash is fine). Local admin app: http://localhost:3001
# This site's origin (e.g. https://beyondai.ph, the staging URL, http://localhost:3000) must be listed in the
# admin app's CORS_ALLOWED_ORIGINS, or browsers block the request and the form falls back to email.
NEXT_PUBLIC_ENQUIRY_API_URL=http://localhost:3001

# Cloudflare Turnstile site key (the secret key lives only in the admin app).
# 1x00000000000000000000AA is Cloudflare's always-pass test key, for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Version of the privacy notice the consent checkbox refers to. Must equal the admin app's CONSENT_NOTICE_VERSION;
# change both together when the notice changes.
NEXT_PUBLIC_CONSENT_NOTICE_VERSION=2026-10

# ── Fallback email (Gmail / Google Workspace SMTP) ───────────────────────────────────────────────────────────
# Used only when the enquiry API fails (5xx, network or CORS error, timeout), so the enquiry still reaches the team.
# These are server-only: never prefix them with NEXT_PUBLIC_.

# The Gmail or Google Workspace account that sends the fallback emails.
SMTP_USER=you@beyondai.ph

# A Google App Password for SMTP_USER (not the account password).
# Requires 2-Step Verification: Google Account → Security → 2-Step Verification → App passwords.
# The 16 characters may be pasted with or without spaces.
SMTP_PASS=

# Where fallback emails are delivered. Defaults to the published contact address (sakib@beyondai.ph) when empty.
CONTACT_TO_EMAIL=

# Optional overrides. Defaults: smtp.gmail.com, port 465 (implicit TLS). Use 587 for STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
