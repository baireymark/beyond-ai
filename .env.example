# Contact form email (Gmail / Google Workspace SMTP).
# Copy to .env.local for local development, and add the same variables in Vercel → Project → Settings → Environment Variables.
# These are server-only: never prefix them with NEXT_PUBLIC_.

# The Gmail or Google Workspace account that sends the enquiry emails.
SMTP_USER=you@beyondai.ph

# A Google App Password for SMTP_USER (not the account password).
# Requires 2-Step Verification: Google Account → Security → 2-Step Verification → App passwords.
# The 16 characters may be pasted with or without spaces.
SMTP_PASS=

# Where enquiries are delivered. Defaults to the published contact address (sakib@beyondai.ph) when empty.
CONTACT_TO_EMAIL=

# Optional overrides. Defaults: smtp.gmail.com, port 465 (implicit TLS). Use 587 for STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
